// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE
  OTHER
}

enum SaleStatus {
  COMPLETED
  HELD
  REFUNDED
  VOID
}

enum PriceTier {
  RETAIL
  WHOLESALE
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARY
  TRANSPORT
  MAINTENANCE
  SUPPLIES
  FOOD
  OTHER
}

enum QuotationStatus {
  OPEN
  CONVERTED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
}

// ============================================================
// Auth (NextAuth v5 + @auth/prisma-adapter compatible)
// ============================================================

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  role           Role      @default(CASHIER)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  sales            Sale[]
  purchases        Purchase[]
  stockMovements   StockMovement[]
  payments         CustomerPayment[]
  supplierPayments SupplierPayment[]
  saleReturns      SaleReturn[]
  expenses         Expense[]
  shiftsOpened     Shift[]           @relation("ShiftOpenedBy")
  shiftsClosed     Shift[]           @relation("ShiftClosedBy")
  quotations       Quotation[]
  auditLogs        AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// Catalog
// ============================================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id             String   @id @default(cuid())
  name           String
  sku            String?  @unique
  barcode        String?  @unique
  description    String?
  unit           String   @default("pcs") // pcs, kg, ltr, box, hr (services)
  costPrice      Decimal? @db.Decimal(12, 2)
  price          Decimal  @db.Decimal(12, 2)
  // Rate for customers on the WHOLESALE tier; null = they pay the normal price.
  wholesalePrice Decimal? @db.Decimal(12, 2)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2) // percentage
  stockQty       Decimal  @default(0) @db.Decimal(12, 3)
  reorderLevel   Decimal? @db.Decimal(12, 3)
  trackStock     Boolean  @default(true) // false for services / untracked items
  isActive       Boolean  @default(true)
  imageUrl       String?
  categoryId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]
  returnItems    SaleReturnItem[]
  quotationItems QuotationItem[]

  @@index([categoryId])
  @@index([name])
}

// ============================================================
// Parties
// ============================================================

model Customer {
  id          String    @id @default(cuid())
  name        String
  phone       String?   @unique
  email       String?
  address     String?
  notes       String?
  creditLimit Decimal?  @db.Decimal(12, 2) // max udhaar allowed; null = no cap
  priceTier   PriceTier @default(RETAIL)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sales      Sale[]
  payments   CustomerPayment[]
  quotations Quotation[]
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
  payments  SupplierPayment[]
}

// ============================================================
// Purchases (stock intake)
// ============================================================

model Purchase {
  id          String    @id @default(cuid())
  referenceNo String? // supplier invoice / reference number
  supplierId  String?
  userId      String? // received by
  subtotal    Decimal   @default(0) @db.Decimal(12, 2)
  taxAmount   Decimal   @default(0) @db.Decimal(12, 2)
  total       Decimal   @default(0) @db.Decimal(12, 2)
  paidAmount  Decimal   @default(0) @db.Decimal(12, 2) // paid to the supplier at the time of purchase
  dueDate     DateTime? // when the unpaid balance must be cleared
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  items          PurchaseItem[]
  stockMovements StockMovement[]
  payments       SupplierPayment[]

  @@index([supplierId])
  @@index([createdAt])
}

model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Decimal @db.Decimal(12, 3)
  unitCost   Decimal @db.Decimal(12, 2)
  lineTotal  Decimal @db.Decimal(12, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([productId])
}

// ============================================================
// Sales
// ============================================================

model Sale {
  id             String        @id @default(cuid())
  invoiceNo      String        @unique
  customerId     String? // null = walk-in customer
  userId         String // cashier
  status         SaleStatus    @default(COMPLETED)
  paymentMethod  PaymentMethod @default(CASH)
  subtotal       Decimal       @db.Decimal(12, 2) // sum of line totals
  discountAmount Decimal       @default(0) @db.Decimal(12, 2) // sale-level discount
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  changeAmount   Decimal       @default(0) @db.Decimal(12, 2)
  dueDate        DateTime? // for credit sales: when the balance must be cleared
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  items          SaleItem[]
  stockMovements StockMovement[]
  payments       CustomerPayment[]
  returns        SaleReturn[]
  quotation      Quotation?

  @@index([customerId])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  productId   String
  productName String // snapshot at sale time
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2) // snapshot at sale time
  discount    Decimal @default(0) @db.Decimal(12, 2) // line-level discount
  lineTotal   Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  returnItems SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
}

// Goods brought back against a completed sale. The sale itself is never edited:
// its effective value is its total minus every return's `amount`, and the cash
// handed back (`refundAmount`) is subtracted from what was collected. Whatever
// value is not paid back in cash stays on the customer's account as credit.
model SaleReturn {
  id           String        @id @default(cuid())
  returnNo     String        @unique
  saleId       String
  userId       String // who processed it
  amount       Decimal       @db.Decimal(12, 2) // value of the goods taken back
  taxAmount    Decimal       @default(0) @db.Decimal(12, 2) // tax share of `amount`
  refundAmount Decimal       @default(0) @db.Decimal(12, 2) // cash paid back to the customer
  refundMethod PaymentMethod @default(CASH)
  reason       String?
  createdAt    DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  items SaleReturnItem[]

  @@index([saleId])
  @@index([createdAt])
}

model SaleReturnItem {
  id         String  @id @default(cuid())
  returnId   String
  saleItemId String
  productId  String
  quantity   Decimal @db.Decimal(12, 3)
  amount     Decimal @db.Decimal(12, 2) // value credited for this line

  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([returnId])
  @@index([saleItemId])
}

// A payment received against a customer's account. With a saleId it settles that
// specific invoice; with saleId null the money sits on the account as an advance.
// Balances are derived from these rows rather than stored on the customer, so a
// refund or void can never leave a stale figure behind.
model CustomerPayment {
  id         String        @id @default(cuid())
  customerId String
  saleId     String?
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod @default(CASH)
  note       String?
  userId     String // who received it
  createdAt  DateTime      @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sale     Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@index([saleId])
}

// Money paid to a supplier. With a purchaseId it settles that purchase; with
// purchaseId null it is an advance on the supplier's account. Like the customer
// ledger, what we owe is derived from purchases and these rows, never stored.
model SupplierPayment {
  id         String        @id @default(cuid())
  supplierId String
  purchaseId String?
  amount     Decimal       @db.Decimal(12, 2)
  method     PaymentMethod @default(CASH)
  note       String?
  userId     String // who paid it
  createdAt  DateTime      @default(now())

  supplier Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([supplierId, createdAt])
  @@index([purchaseId])
}

// ============================================================
// Quotations (estimates) — priced like a sale, but no stock or money moves
// ============================================================

model Quotation {
  id             String          @id @default(cuid())
  quoteNo        String          @unique
  customerId     String?
  // Who the estimate is for when they have no account (e.g. a contractor).
  customerName   String?
  userId         String
  status         QuotationStatus @default(OPEN)
  subtotal       Decimal         @db.Decimal(12, 2)
  discountAmount Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal         @default(0) @db.Decimal(12, 2)
  total          Decimal         @db.Decimal(12, 2)
  validUntil     DateTime?
  note           String?
  // The sale it became. Follows a held bill through to the completed sale.
  saleId         String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  sale     Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)

  items QuotationItem[]

  @@index([status, createdAt])
  @@index([customerId])
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  productId   String
  productName String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([quotationId])
}

// ============================================================
// Running costs and the cash drawer
// ============================================================

// Money spent on running the shop (rent, bills, wages...). A CASH expense is
// taken out of the drawer, so it lowers what a shift expects to find there.
model Expense {
  id        String          @id @default(cuid())
  category  ExpenseCategory
  amount    Decimal         @db.Decimal(12, 2)
  method    PaymentMethod   @default(CASH)
  note      String?
  spentAt   DateTime        @default(now())
  userId    String
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([spentAt])
}

// One opening and closing of the cash drawer. Expected cash is derived from the
// cash that moved between openedAt and closedAt, and frozen onto the row at
// close so later corrections cannot silently rewrite a counted shift.
model Shift {
  id           String    @id @default(cuid())
  openedById   String
  openedAt     DateTime  @default(now())
  openingFloat Decimal   @db.Decimal(12, 2)
  closedById   String?
  closedAt     DateTime?
  expectedCash Decimal?  @db.Decimal(12, 2)
  countedCash  Decimal?  @db.Decimal(12, 2)
  note         String?

  openedBy User  @relation("ShiftOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy User? @relation("ShiftClosedBy", fields: [closedById], references: [id], onDelete: Restrict)

  @@index([openedAt])
  @@index([closedAt])
}

// Who did what to money, stock or settings. Written alongside the change it
// describes and never edited afterwards.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // e.g. sale.refund, stock.adjust, shift.close
  entityType String // e.g. Sale, Product, Shift
  entityId   String?
  summary    String
  details    Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}

// ============================================================
// Inventory audit trail
// ============================================================

model StockMovement {
  id             String            @id @default(cuid())
  productId      String
  type           StockMovementType
  quantityChange Decimal           @db.Decimal(12, 3) // signed: + in, - out
  reason         String?
  saleId         String?
  purchaseId     String?
  userId         String?
  createdAt      DateTime          @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  sale     Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([saleId])
  @@index([purchaseId])
  @@index([createdAt])
}

// ============================================================
// App settings (single-row table)
// ============================================================

model Settings {
  id               String   @id @default("main")
  storeName        String   @default("My Store")
  address          String?
  phone            String?
  currency         String   @default("PKR")
  taxRate          Decimal  @default(0) @db.Decimal(5, 2) // default tax % for new products
  pricesIncludeTax Boolean  @default(true)
  receiptFooter    String?
  updatedAt        DateTime @updatedAt
}
